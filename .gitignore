# macOS
.DS_Store

# Python venv（用 scripts/requirements.txt 重建，不入库）
scripts/.venv/
__pycache__/
*.pyc

# DRAFT 工作文件（ingest-book 跨会话阅读进度，属于本地 WIP，不入库）
*-DRAFT.md
# ingest 阅读进度状态文件（同 DRAFT，本地 WIP）
READING_STATE.md

# 每日新闻哨兵的机器专属自动化装置（写死本机绝对路径，仅本地用，不入库）
# notices.py / daily-news skill / report 日报 仍入库（可复用逻辑与数据）
scripts/daily-news.sh
scripts/com.investor.daily-news.plist

# report/ = 一手源档柜(PDF/HTM/10-K.txt/公告 等) — 源档体积大(~1.7GB)不入 git
# 只入库 report/README.md(放档约定) + 目录本身;用户把下载的年报按约定放进各 <公司>/ 子目录
report/*
!report/README.md

# finance/<公司>/年报季报/ 下的年报季报源 PDF——只入库蒸馏后的 分析.md/.xlsx/财报关注要点.md
finance/**/年报季报/

# 每日新闻哨兵 launchd 运行日志（机器专属，非知识内容，不入库）
knowledge/daily/_logs/

# 大V原始语料(各大V目录下的 _corpus),不入 git
gurus/*/_corpus/

# IDE 配置(不入库)
.idea/
